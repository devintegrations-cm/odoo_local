<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_spr" model="ir.module.category">
        <field name="name">Portal de facturas de proveedor</field>
        <field name="description">Radicacion y validacion de facturas de proveedor</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_spr_validator" model="res.groups">
        <field name="name">Validador</field>
        <field name="category_id" ref="module_category_spr"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Puede ver las solicitudes, validarlas y crear la factura borrador.</field>
    </record>

    <record id="group_spr_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="module_category_spr"/>
        <field name="implied_ids" eval="[(4, ref('group_spr_validator'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Ademas de validar, puede configurar el modulo, rechazar y devolver a borrador.</field>
    </record>

    <record id="purchase.group_purchase_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_spr_manager'))]"/>
    </record>

    <record id="rule_spr_request_company" model="ir.rule">
        <field name="name">Solicitud de pago: multi-compania</field>
        <field name="model_id" ref="model_supplier_payment_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- El proveedor solo ve lo suyo. Se compara contra el partner comercial
         porque el usuario del portal suele ser un contacto hijo de la empresa. -->
    <record id="rule_spr_request_portal" model="ir.rule">
        <field name="name">Solicitud de pago: el proveedor solo ve las suyas</field>
        <field name="model_id" ref="model_supplier_payment_request"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_spr_line_portal" model="ir.rule">
        <field name="name">Linea de solicitud: el proveedor solo ve las suyas</field>
        <field name="model_id" ref="model_supplier_payment_request_line"/>
        <field name="domain_force">[('request_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
