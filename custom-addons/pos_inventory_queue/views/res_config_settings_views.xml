<?xml version="1.0" encoding="utf-8" ?>

<odoo>

    <!-- ============================================================ -->
    <!-- Switch GLOBAL de la cola de inventario del POS               -->
    <!--                                                              -->
    <!-- IMPORTANTE: 'pos_inventory_queue_enabled' se guarda en       -->
    <!-- ir.config_parameter (parametro 'pos_inventory_queue.enabled'),-->
    <!-- NO en pos.config. Es un interruptor GLOBAL que afecta a      -->
    <!-- TODOS los terminales, por eso el bloque se inyecta a nivel de -->
    <!-- <app> (fuera del <div invisible="not pos_config_id"> que      -->
    <!-- gatinga el resto de opciones por punto de venta) y se muestra-->
    <!-- siempre, haya o no un POS seleccionado.                      -->
    <!-- ============================================================ -->
    <record id="res_config_settings_view_form_pos_inventory_queue" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.inventory.queue</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Inventory Queue">
                    <setting string="POS Inventory Queue"
                             help="GLOBAL switch. Applies to every point of sale, not just the selected one.">
                        <field name="pos_inventory_queue_enabled"/>
                        <div class="text-muted mt8">
                            Configuracion GLOBAL: no depende del punto de venta
                            seleccionado arriba. Al desactivarla, los movimientos de
                            inventario se procesan de forma sincronizada (como si el
                            modulo no existiera) y la cola solo termina lo pendiente.
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>

</odoo>
