<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="res_config_settings_view_form_pos_discount_code" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.discount.code</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos-loyalty']" position="after">
                <setting id="pos_discount_code"
                         string="Botón de descuento (Convenio To Plus)"
                         help="Botón en el POS para capturar tipo de documento, número de documento y código de descuento">
                    <field name="pos_show_discount_code_button"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
