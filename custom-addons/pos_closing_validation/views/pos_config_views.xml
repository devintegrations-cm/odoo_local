<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="res_config_settings_view_form_pos_closing_validation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.closing.validation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='pos_amount_authorized_diff']" position="after">
                <div class="mt16">
                    <label
                        for="pos_maximum_cash_in_out_moves"
                        string="Máximo de movimientos de efectivo"
                        class="fw-normal"
                    />
                    <field name="pos_maximum_cash_in_out_moves"/>
                </div>
                <div class="mt16">
                    <label
                        for="pos_cash_difference_exceeded_message"
                        string="Mensaje de diferencia de efectivo"
                        class="fw-normal"
                    />
                    <field name="pos_cash_difference_exceeded_message"
                        placeholder="Se usará el mensaje por defecto si se deja vacío."
                    />
                    <div class="text-muted mt8">
                        Los valores de la diferencia y del máximo autorizado se añaden
                        automáticamente al final del mensaje.
                    </div>
                </div>
                <div class="mt16">
                    <field name="pos_enable_rescue_session_validation"/>
                    <label
                        for="pos_enable_rescue_session_validation"
                        string="Validar sesiones de rescate"
                        class="fw-normal"
                    />
                    <div class="text-muted mt8">
                        Muestra advertencias cuando existan sesiones de rescate
                        pendientes al cerrar la sesión normal.
                    </div>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
