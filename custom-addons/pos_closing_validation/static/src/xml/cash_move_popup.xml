<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <!-- Cash move popup extension -->
    <t t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension">

        <!-- Cash summary before the form -->
        <xpath expr="//div[contains(@class, 'form-floating')]" position="before">

            <!-- Load error alert: shown when the backend call failed -->
            <div t-if="state.loadError"
                 class="alert alert-warning mt-2 mb-2"
                 role="alert">
                <strong>No se pudo cargar la información. </strong>
                Cierre esta ventana y vuelva a intentarlo. Si el problema
                persiste, contacte a un administrador del Punto de Venta.
            </div>

            <!-- Cash summary (only when load is OK) -->
            <div t-if="!state.loadError" class="mt-2 mb-2 p-2 border rounded">
                <div class="fw-bold mb-1 small">
                    Resumen de efectivo
                </div>
                <div class="d-flex justify-content-between small">
                    <span class="text-muted">Apertura:</span>
                    <span t-esc="env.utils.formatCurrency(closingValidation.opening_cash || 0)"/>
                </div>
                <div class="d-flex justify-content-between small"
                     t-if="closingValidation.cash_sales > 0">
                    <span class="text-muted">Ventas en efectivo:</span>
                    <span t-esc="env.utils.formatCurrency(closingValidation.cash_sales || 0)"/>
                </div>
                <div class="d-flex justify-content-between small text-success"
                     t-if="closingValidation.cash_in > 0">
                    <span class="text-muted">Cash In:</span>
                    <span t-esc="env.utils.formatCurrency(closingValidation.cash_in || 0)"/>
                </div>
                <div class="d-flex justify-content-between small text-danger"
                     t-if="closingValidation.cash_out > 0">
                    <span class="text-muted">Cash Out:</span>
                    <span t-esc="env.utils.formatCurrency(closingValidation.cash_out || 0)"/>
                </div>
                <div class="d-flex justify-content-between small fw-bold border-top mt-1 pt-1">
                    <span>Efectivo esperado:</span>
                    <span t-esc="env.utils.formatCurrency(closingValidation.expected_cash || 0)"/>
                </div>
            </div>

            <!-- Limit reached alert (only when load is OK to avoid
                 misreading a network error as "you hit your limit") -->
            <div t-if="state.isLimitReached &amp;&amp; !state.loadError"
                 class="alert alert-danger mt-2 mb-2"
                 role="alert">
                <strong>Límite alcanzado: </strong>
                Se han registrado los
                <t t-esc="cashMoveControl.count"/>/<t t-esc="cashMoveControl.limit"/>
                movimientos permitidos para esta sesión.
            </div>

        </xpath>

        <!-- Movement counter after the form -->
        <xpath expr="//div[contains(@class, 'form-floating')]" position="after">

            <div t-if="!state.loadError" class="text-muted small mt-2 text-end">
                Movimientos:
                <t t-esc="cashMoveControl.count"/>
                /
                <t t-esc="cashMoveControl.limit"/>
            </div>

        </xpath>

        <!-- Disable confirm button when limit reached -->
        <xpath expr="//button[contains(@class, 'confirm')]" position="attributes">
            <attribute name="t-att-disabled">
                !env.utils.isValidFloat(state.amount) || state.isLimitReached
            </attribute>
        </xpath>

    </t>

</templates>
