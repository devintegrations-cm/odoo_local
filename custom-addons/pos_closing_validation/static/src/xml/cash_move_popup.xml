<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension">

        <xpath expr="//div[contains(@class, 'form-floating')]" position="before">

            <div t-if="state.isLimitReached"
                 class="alert alert-danger mt-2 mb-2"
                 role="alert">
                <strong>Límite alcanzado: </strong>
                Se han registrado los
                <t t-esc="cashMoveControl.count"/>/<t t-esc="cashMoveControl.limit"/>
                movimientos permitidos para esta sesión.
            </div>

        </xpath>

        <xpath expr="//div[contains(@class, 'form-floating')]" position="after">

            <div class="text-muted small mt-2 text-end">
                Movimientos:
                <t t-esc="cashMoveControl.count"/>
                /
                <t t-esc="cashMoveControl.limit"/>
            </div>

        </xpath>

        <xpath expr="//button[contains(@class, 'confirm')]" position="attributes">
            <attribute name="t-att-disabled">
                !env.utils.isValidFloat(state.amount) || state.isLimitReached
            </attribute>
        </xpath>

    </t>

</templates>
