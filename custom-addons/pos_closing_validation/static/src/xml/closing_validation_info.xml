<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <t t-name="pos_closing_validation.ClosingValidationInfo">

        <!-- Rescue session banner -->
        <div t-if="isRescue"
             class="alert alert-warning mt-2 mb-2"
             role="alert">
            <strong>
                <t t-esc="rescueLabel"/>
            </strong>
            <div class="mt-1 text-muted small">
                Esta sesión está recuperando operaciones de una sesión anterior.
            </div>
        </div>

        <!-- Cash summary (always shown) -->
        <div class="mt-2 mb-2 p-2 border rounded bg-100">
            <div class="fw-bold mb-1">
                Resumen de efectivo
            </div>
            <table class="table table-sm table-borderless mb-0">
                <tr>
                    <td class="text-muted">Apertura:</td>
                    <td class="text-end" t-esc="openingCash"/>
                </tr>
                <tr>
                    <td class="text-muted">Ventas en efectivo:</td>
                    <td class="text-end" t-esc="cashSales"/>
                </tr>
                <tr t-if="info.cash_in > 0">
                    <td class="text-muted">Cash In:</td>
                    <td class="text-end text-success" t-esc="cashIn"/>
                </tr>
                <tr t-if="info.cash_out > 0">
                    <td class="text-muted">Cash Out:</td>
                    <td class="text-end text-danger" t-esc="cashOut"/>
                </tr>
                <tr class="border-top fw-bold">
                    <td>Efectivo esperado:</td>
                    <td class="text-end" t-esc="expectedCash"/>
                </tr>
            </table>
        </div>

    </t>

</templates>
