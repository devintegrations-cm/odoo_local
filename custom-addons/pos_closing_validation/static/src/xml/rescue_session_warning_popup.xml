<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <t t-name="pos_closing_validation.RescueSessionWarningPopup">
        <div class="popup popup-confirm rescue-popup">
            <div class="modal-header">
                <h4 class="modal-title">
                    <t t-esc="props.title"/>
                </h4>
            </div>
            <main class="modal-body">
                <p>
                    <t t-esc="props.body"/>
                </p>
            </main>
            <footer class="footer modal-footer">
                <div class="button highlight btn btn-lg btn-primary" t-on-click="onReload">
                    Actualizar Página
                </div>
            </footer>
        </div>
    </t>

</templates>
